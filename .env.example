# Padrão: bancos do docker compose (portas deslocadas para não brigar com bancos locais).
# Se usar Postgres.app/brew local, troque para PG_PORT=5432 e MONGO_URI=mongodb://localhost:27017
PG_HOST=localhost
PG_PORT=5433
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=loja_vinil

MONGO_URI=mongodb://localhost:27018
MONGO_DB=loja_vinil
